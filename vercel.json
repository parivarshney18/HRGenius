{
  "framework": "angular",
  "installCommand": "cd hrgenius-frontend && npm ci",
  "buildCommand": "cd hrgenius-frontend && npm run build",
  "outputDirectory": "hrgenius-frontend/dist/hrgenius-frontend/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
